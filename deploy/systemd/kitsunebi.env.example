# Copy to /etc/kitsunebi/kitsunebi.env and set deployment-specific values.
# Expose the loopback listener through a Cloudflare Tunnel protected by Access.
KITSUNEBI_MODE=production
KITSUNEBI_LOCAL_AUTH=false
KITSUNEBI_LISTEN_ADDR=127.0.0.1:8080
KITSUNEBI_ALLOWED_ORIGINS=
# At least 32 non-whitespace bytes; load this from the deployment secret manager.
KITSUNEBI_CSRF_SECRET=
DATABASE_URL=
GAMEAP_BASE_URL=
GAMEAP_PAT=
GAMEAP_ALLOW_CREATION=false
GAMEAP_API_VERSION=
GAMEAP_SCHEMA_SHA256=
TCPSHIELD_BASE_URL=
TCPSHIELD_API_KEY=
TCPSHIELD_NETWORK_ID=
KITSUNEBI_BACKUP_BASE_URL=
# Load the backup bearer token from the deployment secret manager.
KITSUNEBI_BACKUP_TOKEN=
KITSUNEBI_MONITORING_BASE_URL=
# Load the monitoring bearer token from the deployment secret manager.
KITSUNEBI_MONITORING_TOKEN=
KITSUNEBI_ARTIFACT_ROOT=/var/lib/kitsunebi/artifacts
KITSUNEBI_WEB_STATIC_ROOT=/var/lib/kitsunebi/web
CLOUDFLARE_ACCESS_ISSUER=
CLOUDFLARE_ACCESS_AUDIENCE=
CLOUDFLARE_ACCESS_JWKS_URL=
